# Signing key for portal session tokens. MUST be byte-identical to the
# TOKEN_SECRET Script Property in the Apps Script project — a mismatch means
# every realtor's token fails to verify here while still working in the portal.
TOKEN_SECRET=

# The deployed Apps Script web app (same value as EXEC in
# portal/dev/config.mjs).
EXEC_URL=https://script.google.com/macros/s/AKfycbxB20Mc56_q__y-1-EbXGFDVODqwTNv3lyj7zuuuXDm8WVBaCDpHqHWHtIQWXNqDojC-g/exec

# Per-request timeout against the portal, in seconds. Cold index builds are slow.
EXEC_TIMEOUT_S=30.0

# Token lifetime in ms. MUST match SESSION_MS in Core.js -- a longer window here
# keeps honouring tokens the portal has already retired.
SESSION_MS=604800000

# OpenRouter — added in Phase 3, unused until then.
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
# Ceiling on one answer. Providers otherwise advertise their whole context, and
# OpenRouter reserves credit against it before the call.
LLM_MAX_TOKENS=1500

# Postgres — added in Phase 4, unused until then.
DATABASE_URL=

# Unbrander job worker. Off and dry run by default: turning it on starts model
# spend, and only dry run = false files into the real Unbranded tree.
UNBRANDER_ENABLED=false
UNBRANDER_DRY_RUN=true
# A Railway volume in production, e.g. /data/unbrander.
UNBRANDER_DATA_DIR=.local/unbrander
UNBRANDER_RETENTION_DAYS=30
UNBRANDER_MAX_FILE_MB=150
UNBRANDER_MAX_PAGES=60
UNBRANDER_DOCS_PER_DAY=30
UNBRANDER_DOC_TIMEOUT_MIN=10

# Google service account: unbrander@aura-agent-510816.iam.gserviceaccount.com
# Key: the whole JSON file's contents on one line.
# Secret. Never commit it, never paste it anywhere else.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The "Aura Agent" Shared Drive and its folders (docs/feature/Unbrander/PHASES.md, U0).
DRIVE_SHARED_DRIVE_ID=0AAos_9jUJ7hLUk9PVA
DRIVE_ROOT_FOLDER_ID=1JzHRpjdghrbd3eVZgeDpXB3-Xkx6z4JX
DRIVE_TEST_ROOT_FOLDER_ID=1HUH-DNChIiWnXF9KOjhszRDzBrI4Ucos
